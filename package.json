{
  "name": "opengym-mcp",
  "version": "1.0.0",
  "description": "Remote MCP server for openGym: lets AI assistants read and edit a paired openGym profile over OAuth.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "test:browser": "playwright test",
    "test:contract": "node test/contract.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "node-fetch": "3.3.2",
    "ssrf-req-filter": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
