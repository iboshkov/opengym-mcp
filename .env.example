# Copy to .env and edit. Every setting is described in docs/CONFIGURATION.md.

# Public HTTPS address of this MCP service (origin only, no path).
PUBLIC_ORIGIN=https://gym-mcp.example.com

# Address of your openGym instance, as this service reaches it.
OPENGYM_URL=https://gym.example.com

# Address people open openGym at in a browser. Only needed when OPENGYM_URL
# is an internal address such as http://api:3000.
#OPENGYM_PUBLIC_URL=https://gym.example.com

# Host port the service is published on (bound to 127.0.0.1).
MCP_PORT=8082

# Reverse proxies between the internet and this service. 0 when there is none.
TRUST_PROXY_HOPS=1

TZ=UTC
